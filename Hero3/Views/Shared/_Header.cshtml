<script>
	document.addEventListener("DOMContentLoaded", function () {
		const searchToggle = document.querySelector('[data-kt-search-element="toggle"]');
		const searchContent = document.querySelector('[data-kt-search-element="content"]');
		const searchInput = searchContent.querySelector('[data-kt-search-element="input"]');
		const searchResults = searchContent.querySelector('[data-kt-search-element="main"]');
		const searchEmpty = searchContent.querySelector('[data-kt-search-element="empty"]');

		// Toggle search dropdown
		searchToggle.addEventListener("click", () => {
			searchContent.classList.toggle("d-none");
			searchInput.focus();
		});

		// Handle input
		searchInput.addEventListener("input", async function () {
			const query = searchInput.value.trim();

			if (query.length < 2) {
				searchResults.innerHTML = "";
				searchEmpty.classList.add("d-none");
				return;
			}

			// Simulate async search; replace with your backend API
			const results = await fakeSearch(query);

			if (results.length === 0) {
				searchResults.innerHTML = "";
				searchEmpty.classList.remove("d-none");
			} else {
				searchEmpty.classList.add("d-none");
				searchResults.innerHTML = results
					.map(item => `<div class="py-2">${item}</div>`)
					.join("");
			}
		});

		// Fake search function (replace with real AJAX call)
		function fakeSearch(query) {
			const data = ["Leave Request", "Dashboard", "Employee Profile", "Settings"];
			return new Promise(resolve => {
				setTimeout(() => {
					resolve(data.filter(x => x.toLowerCase().includes(query.toLowerCase())));
				}, 200);
			});
		}
	});
</script>