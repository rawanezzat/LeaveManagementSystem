@model IEnumerable<Hero.Models.LeaveType>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TypeName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxDaysPerYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxConsecutiveDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MinNoticeDays)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxHoursPerRequest)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxTimesPerMonth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequiresApproval)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequiresMedicalNote)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequiresAttachment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MustUsePaidLeaveFirst)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsUnpaid)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxDaysPerYear)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxConsecutiveDays)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MinNoticeDays)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxHoursPerRequest)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaxTimesPerMonth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequiresApproval)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequiresMedicalNote)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RequiresAttachment)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MustUsePaidLeaveFirst)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsUnpaid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.LeaveTypeId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.LeaveTypeId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.LeaveTypeId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
