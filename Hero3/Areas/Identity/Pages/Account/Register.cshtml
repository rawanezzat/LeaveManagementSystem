@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}


<div class="container d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 460px; width:100%;">
        <div class="text-center mb-4">
            <i class="bi bi-person-plus-fill text-primary fs-1"></i>
            <h2 class="fw-bold mb-1">Create Account</h2>
            <p class="text-muted">Join us and get started today</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <!-- Username -->
            <div class="form-floating mb-3">
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" placeholder="Enter your username" />
                <label asp-for="Input.UserName">Username</label>
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>


            <!-- Email -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Department -->
            <div class="form-floating mb-3">
                <input asp-for="Input.UserDepartment" class="form-control" placeholder="Enter your department" />
                <label asp-for="Input.UserDepartment">Department</label>
                <span asp-validation-for="Input.UserDepartment" class="text-danger"></span>
            </div>
            <!-- Position -->
            <div class="form-floating mb-3">
                <input asp-for="Input.UserPosition" class="form-control" placeholder="Enter your position" />
                <label asp-for="Input.UserPosition">Position</label>
                <span asp-validation-for="Input.UserPosition" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" placeholder="confirm password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Submit -->
            <button id="registerSubmit" type="submit" class="btn btn-primary w-100 py-2">Register</button>
        </form>

        <!-- Divider -->
        <div class="text-center my-3">
            <span class="text-muted">or</span>
        </div>

        <!-- External logins -->
        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="d-grid gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Register with @provider.DisplayName
                            </button>
                        }
                    </div>
                </form>
            }
        }

        <!-- Login link -->
        <div class="text-center mt-4">
            <span class="text-muted">Already have an account?</span>
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none ms-1">Log in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
