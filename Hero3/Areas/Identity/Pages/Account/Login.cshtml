@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="container d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 420px; width:100%;">
        <div class="text-center mb-4">
            <i class="bi bi-person-circle text-primary fs-1"></i>
            <h2 class="fw-bold mb-1">Log In</h2>
            <p class="text-muted">Access your account securely</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <!-- Username -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Username" class="form-control" placeholder="Enter username" autocomplete="username" />
                <label asp-for="Input.Username">Username / Email</label>
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <!-- Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" autocomplete="current-password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

          

            <!-- Login Button -->
            <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2">Log in</button>
        </form>

        <!-- Register link -->
        <div class="text-center mt-3">
            <span class="text-muted">Don’t have an account?</span>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none ms-1">Register</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
