@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked Out";
}

<div class="container d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-lg border-0 rounded-4 p-4 text-center" style="max-width: 460px; width:100%;">

        <!-- Icon & Title -->
        <div class="mb-3">
            <i class="bi bi-lock-fill text-danger fs-1"></i>
        </div>
        <h2 class="fw-bold text-danger mb-2">Account Locked</h2>
        <p class="text-muted">
            Your account has been temporarily locked due to multiple failed login attempts.
            Please try again after 1 m.
        </p>

        <!-- Action Buttons -->
        <div class="d-grid gap-2 mt-4">
            <a asp-page="./Login" class="btn btn-outline-primary">
                <i class="bi bi-box-arrow-in-right me-1"></i> Back to Login
            </a>
           
        </div>
    </div>
</div>
